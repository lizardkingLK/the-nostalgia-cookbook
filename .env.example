# -----------------------------------------------------------------------------
# Nostalgia Cookbook - Environment Configuration Template
# -----------------------------------------------------------------------------

# NextAuth Authentication Configuration
# Generate a secure 32-byte secret with: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-nextauth-secret-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud OAuth 2.0 Credentials (Sign In with Google)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                         https://<YOUR_DIGITALOCEAN_APP_DOMAIN>/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# MongoDB Atlas Cloud Database Connection
# Format: mongodb+srv://<username>:<password>@cluster0.your-subdomain.mongodb.net/nostalgia_cookbook?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://family_archivist:yourPassword@cluster0.mongodb.net/nostalgia_cookbook?retryWrites=true&w=majority"

# Google Gemini API Key (Multimodal audio transcription via @google/genai SDK)
# AI Studio automatically injects this in development; provide in production
GEMINI_API_KEY="your-gemini-api-key"

# DigitalOcean GPU Droplet Gemma Inference Endpoint
# Ollama runs on port 11434 by default.
# Option A (Local development with Ollama):
# GEMMA_API_ENDPOINT="http://localhost:11434/api/generate"
# Option B (DigitalOcean Private VPC between App Platform & GPU Droplet):
# GEMMA_API_ENDPOINT="http://10.116.0.4:11434/api/generate"
# Option C (Secure domain proxy with Caddy/Nginx on Droplet):
# GEMMA_API_ENDPOINT="https://gemma.your-domain.com/api/generate"
GEMMA_API_ENDPOINT="http://localhost:11434/api/generate"
GEMMA_MODEL="gemma2:9b"

# Port configuration
PORT=3000
